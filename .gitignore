# Hidden files
.*
!.git*
!.dashboard.yaml
!.dockerignore

# Dependencies
node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
venv/

# ML artifacts
*.pth
*.pt
*.onnx
# The MNIST cache — anchored so the intent is legible (and only this path).
/classifiers/data/

# Testing
htmlcov/

# Build
*.log

# The linter plugin is shared, so its settings file is tracked. Re-including the
# directory is required before the file, then everything else there stays local.
!.claude/
.claude/*
!.claude/settings.json
